{
  "schemaVersion": "1.0",
  "effectiveAt": "2026-08-11T21:30:00+08:00",
  "status": "active",
  "coreRule": "Competitor wikis, gameplay videos, video frames, community pages and other identifiable web pages are eligible factual sources. Publication status depends on field completeness, date, context and known conflicts, not on whether a source is official.",
  "requiredFields": ["gameIdentity", "factName", "value", "unitOrIngredientsWhenApplicable", "conditions", "versionOrObservedDate", "sourceUrl"],
  "publicationStates": ["current_fact", "dated_fact", "listed_status_open", "conflicted", "expired_or_historical", "blocked"],
  "originalityGate": {
    "preserve": ["names", "numbers", "units", "codes", "recipe ingredients", "conditions", "dates", "source URLs"],
    "prohibit": ["source sentences", "source heading order", "source paragraph order", "source table layout", "source screenshots or graphics", "synonym-only rewriting"]
  },
  "sharedPolicy": "../../work/roblox-external-fact-processing-policy-20260811.md"
}
