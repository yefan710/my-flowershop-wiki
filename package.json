    "release-check": "npm run check"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.26",
    "sharp": "0.35.3"
  }
